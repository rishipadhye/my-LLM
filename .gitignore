# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Data, tokenizers, checkpoints, logs (large / regenerable)
data/
checkpoints/
*.ckpt
*.pt
*.pth
*.bin
*.safetensors
tokenizer/
*.model
*.vocab

# Kaggle dataset staging payload (hardlinked from data/ and tokenizer/; local-only,
# uploaded via the Kaggle CLI — only dataset-metadata.json is tracked)
scripts/kaggle_dataset/train.bin
scripts/kaggle_dataset/val.bin
scripts/kaggle_dataset/tokenizer.json
logs/
runs/
wandb/
outputs/

# Plots (regenerable from logs) — comment out if you want to commit figures
# figures/
# *.png

# Secrets / credentials — never commit these
kaggle.json
*.pem
*.key
.env
.env.*
credentials*.json
secrets*.json

# Claude Code local (per-machine) settings
.claude/settings.local.json

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
